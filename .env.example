AWIN_DATAFEED_API_KEY=

# Yksi rivi per hyväksytty Awin-kauppa. Nimen pitää täsmätä
# src/stores-registry.ts:n feedIdEnvVar-kenttään.
AWIN_OUTNORTH_SE_FEED_ID=
AWIN_OUTNORTH_FI_FEED_ID=
AWIN_VOGHION_GLOBAL_FEED_ID=

KV_REST_API_URL=
KV_REST_API_TOKEN=

CRON_SECRET=

# --- AI-web-hakuvarapolku (kun mikään kauppa ei löydä tuloksia) ---
ANTHROPIC_API_KEY=
AI_SEARCH_MODEL=claude-haiku-4-5-20251001
AI_SEARCH_MAX_USES=6
AI_SEARCH_DAILY_LIMIT=50
AI_SEARCH_CACHE_TTL_SECONDS=7200

# --- LLM-tulkinta (sääntöparserin varapolku) ---
# Käytetään kun haun vaatetyyppiä ei tunnisteta tai teksti ei ole suomea
# (ruotsi, englanti, tanska, norja). Päällä kun ANTHROPIC_API_KEY on asetettu.
# Poista käytöstä: NLU_LLM_ENABLED=false
NLU_LLM_ENABLED=true
# Oletus: sama malli kuin AI_SEARCH_MODEL
NLU_LLM_MODEL=
NLU_LLM_DAILY_LIMIT=500
NLU_LLM_CACHE_TTL_SECONDS=86400
NLU_LLM_TIMEOUT_MS=8000
